# Copy to .env and adjust. Never commit real secrets.

APP_NAME="Tamil-Heritage API"
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL (production):  postgresql+psycopg2://user:password@host:5432/tamil_heritage
# SQLite (local demo / hackathon): (default below)
DATABASE_URL=sqlite:///./tamil_heritage.db

# Allowed browser origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seeded admin account (only used when the database is empty)
ADMIN_EMAIL=admin@tamilheritage.org
ADMIN_PASSWORD=HeritageAdmin#2024

MEDIA_DIR=storage
MAX_UPLOAD_MB=8
